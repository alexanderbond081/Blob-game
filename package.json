    "build:poki": "node scripts/generate-build-info.cjs production poki && webpack --mode production && node scripts/write-build-artifact.cjs",
    "build:crazygames": "node scripts/generate-build-info.cjs production crazygames && webpack --mode production && node scripts/write-build-artifact.cjs",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
